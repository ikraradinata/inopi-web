# Salin ke .env.local untuk pengembangan; isi yang sama di Vercel (Settings → Environment Variables).
# Panduan lengkap: apps-script/README.md

# Pencatatan pendaftaran anggota (Google Apps Script di Sheet PENDAFTARAN)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Rekening tujuan iuran (tampil di layar pembayaran)
MEMBERSHIP_BANK_NAME=
MEMBERSHIP_BANK_NUMBER=
MEMBERSHIP_BANK_OWNER=

# Tujuan tautan pendek inopi.id/daftar (QR cetak). Kosong = /keanggotaan/daftar.
# Ubah di Vercel lalu Redeploy; QR yang sudah tercetak tetap berlaku.
DAFTAR_REDIRECT_URL=
